  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
