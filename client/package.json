{
  "name": "@cambio/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_BUILD_VERSION=${VITE_BUILD_VERSION:-$(git rev-parse --short=5 HEAD)} vite",
