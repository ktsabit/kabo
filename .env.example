# Public Application ID: Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=
# Private: Developer Portal → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=
# Private: Developer Portal → Bot → Token / Reset Token
# Strongly recommended in production: validates Discord Activity instances.
DISCORD_BOT_TOKEN=
# Developer Portal → General Information → Public Key
DISCORD_PUBLIC_KEY=
# Optional: set this for instant guild-command updates while testing.
DISCORD_GUILD_ID=
# Set true once to register /leaderboard, then set false again.
DISCORD_REGISTER_COMMANDS=false
ALLOW_GUESTS=true
PORT=8080
CLIENT_DIST=../client/dist
DB_PATH=/data/kabo.sqlite
KABO_TURN_TIMEOUT=15s
KABO_REVEAL_TIMEOUT=3s
